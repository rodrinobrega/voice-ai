# Voice AI backend — environment variables
#
# For `serverless-offline` / local dev, copy this file to `.env` and fill in
# real values. In deployed stages these are set by `serverless.yml` (mostly
# derived from stack outputs / SSM), NOT read from a committed `.env`.
#
# AWS_REGION is intentionally NOT listed here: it's a reserved Lambda runtime
# environment variable that AWS sets automatically and cannot be overridden
# via serverless.yml's `environment:` block. For local tooling (AWS CLI,
# serverless-offline) it comes from your AWS CLI profile / `--region` flag.

# --- DynamoDB ---
# Name of the single-table DynamoDB table (see docs/CONTRACTS.md).
DYNAMODB_TABLE=voice-ai-transcriptions-dev

# --- S3 ---
# Bucket audio files are uploaded to (private, 30-day lifecycle expiry).
AUDIO_BUCKET=voice-ai-audio-dev
# Bucket transcript .txt/.json outputs are stored in (private, no expiry).
TRANSCRIPTS_BUCKET=voice-ai-transcripts-dev

# --- Cognito ---
# User Pool backing the HTTP API's JWT authorizer.
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
# Public (no-secret) App Client id used by the frontend for SRP auth.
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Speechmatics ---
# SSM parameter *names* (not the secret values themselves) holding the
# Speechmatics permanent API key and the webhook shared secret, both stored
# as SecureString parameters.
SPEECHMATICS_API_KEY_PARAM=/voice-ai/dev/speechmatics-api-key
SPEECHMATICS_WEBHOOK_SECRET_PARAM=/voice-ai/dev/speechmatics-webhook-secret
# Speechmatics batch/management API base URL.
SPEECHMATICS_BASE_URL=https://asr.api.speechmatics.com/v2
# Speechmatics real-time WebSocket URL returned to the frontend.
SPEECHMATICS_RT_URL=wss://eu2.rt.speechmatics.com/v2

# --- Misc ---
# Deployment stage name (dev | prod | pr-<number>).
STAGE=dev
# Public base URL of this stage's own HTTP API, used by `processUploadedAudio`
# to build the Speechmatics `notification_config` webhook callback URL.
# Populated automatically in serverless.yml from the HTTP API's ApiEndpoint;
# only needs to be set by hand here for fully local (serverless-offline) runs.
API_BASE_URL=http://localhost:3001

# --- Deploy-time only (read by serverless.yml, not by the Lambdas themselves) ---
# Origin allowed by API Gateway/S3 CORS configuration (the deployed CloudFront domain in prod).
WEB_ORIGIN=http://localhost:3000

# --- Local-only, never used by deployed Lambdas ---
# Used solely by developer tooling (AWS CLI / scripts) when pointed at a real
# dev-stage Cognito pool for local auth testing, per ARCHITECTURE.md §10.
# AWS_PROFILE=voice-ai-dev
