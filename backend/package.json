{
  "name": "voice-ai-backend",
  "version": "1.0.0",
  "description": "Voice AI audio-transcription platform — serverless backend (AWS Lambda + DynamoDB + S3 + Cognito + Speechmatics).",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "serverless deploy --stage ${STAGE:-dev}",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove --stage ${STAGE:-dev}",
    "offline": "serverless offline start --stage dev"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-ssm": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/s3-presigned-post": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.138",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "serverless": "^3.39.0",
    "serverless-esbuild": "^1.52.1",
    "serverless-offline": "^13.6.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  }
}
