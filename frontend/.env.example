# Copy to .env and fill in for local development.
# All variables are public (bundled into the static SPA build) — never put
# secrets here. See docs/CONTRACTS.md "Env vars (frontend, NUXT_PUBLIC_*)".

# Base URL of the deployed/local API Gateway HTTP API (serverless-offline
# defaults to http://localhost:3001 locally).
NUXT_PUBLIC_API_BASE=http://localhost:3001

# Cognito User Pool used for sign-up/sign-in/sign-out (dev-stage pool in AWS,
# per ARCHITECTURE.md §10 — no local Cognito emulator).
NUXT_PUBLIC_COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
NUXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

NUXT_PUBLIC_AWS_REGION=eu-west-1
